<?xml version="1.0" encoding="utf-8"?>
<!-- A browser opens http:// pages too. usesCleartextTraffic alone is marked to stop having an effect in a future
     Android release; this file keeps cleartext allowed. Certificates: the system's trusted authorities only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
