{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "commonjs",
    "moduleResolution": "node10",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/core/**/*.js", "src/main/**/*.js", "src/preload/**/*.js", "src/types/**/*.d.ts", "scripts/**/*.js"],
  "exclude": ["node_modules", "dist"]
}
