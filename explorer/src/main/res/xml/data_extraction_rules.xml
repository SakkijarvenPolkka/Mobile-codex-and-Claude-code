<?xml version="1.0" encoding="utf-8"?>
<!--
  Files — what Android 12 and later may back up or move to a new device: not the settings, whose
  saved tabs, favorites and recent files name this device's volumes and paths, nor the journal of
  the file operations (files/ops), whose operations name them too and are this device's to finish.
  SPDX-License-Identifier: MIT
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="explorer_settings.xml" />
        <exclude domain="file" path="ops/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="explorer_settings.xml" />
        <exclude domain="file" path="ops/" />
    </device-transfer>
</data-extraction-rules>
